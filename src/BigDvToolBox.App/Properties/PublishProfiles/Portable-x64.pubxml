<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>x64</Platform>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
    <GeneratePortableArchive>true</GeneratePortableArchive>
    <PortablePublishSessionId>$([System.Guid]::NewGuid().ToString('N'))</PortablePublishSessionId>
    <PublishDir>$(MSBuildProjectDirectory)\..\..\artifacts\vs-publish\$(PortablePublishSessionId)\publish\</PublishDir>
    <PublishUrl>$(PublishDir)</PublishUrl>
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>true</PublishReadyToRun>
    <NoBuild>false</NoBuild>
    <DeleteExistingFiles>false</DeleteExistingFiles>
  </PropertyGroup>
</Project>