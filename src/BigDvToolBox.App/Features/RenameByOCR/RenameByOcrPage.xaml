<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="BigDvToolBox_App.Features.RenameByOCR.RenameByOcrPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:BigDvToolBox_App.Features.RenameByOCR"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Loaded="Page_Loaded"
    mc:Ignorable="d">

    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>


        <Grid Grid.Row="0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,12,0" Spacing="14">
                    <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Rename By OCR" />
                    <TextBlock Text="从 PDF 或图片中识别文字，先检查目标名称，再批量重命名。" TextWrapping="Wrap" />


                    <TextBox
                        AutomationProperties.AutomationId="SelectedOcrFolder"
                        Header="当前来源"
                        IsReadOnly="True"
                        Text="{x:Bind ViewModel.InputSourceDisplay, Mode=OneWay}"
                        TextWrapping="Wrap" />

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            HorizontalAlignment="Stretch"
                            AutomationProperties.AutomationId="PreviousOcrFileButton"
                            Click="PreviousFile_Click"
                            Content="上一个"
                            IsEnabled="{x:Bind ViewModel.CanNavigate, Mode=OneWay}" />
                        <Button
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.AutomationId="NextOcrFileButton"
                            Click="NextFile_Click"
                            Content="下一个"
                            IsEnabled="{x:Bind ViewModel.CanNavigate, Mode=OneWay}" />
                    </Grid>
                    <TextBlock
                        AutomationProperties.AutomationId="CurrentOcrFile"
                        Text="{x:Bind ViewModel.CurrentFileDisplay, Mode=OneWay}"
                        TextWrapping="Wrap" />

                    <NumberBox
                        AutomationProperties.AutomationId="PdfDpiInput"
                        Header="PDF 渲染 DPI"
                        IsEnabled="{x:Bind ViewModel.CanConfigure, Mode=OneWay}"
                        Maximum="1200"
                        Minimum="72"
                        SmallChange="50"
                        SpinButtonPlacementMode="Compact"
                        ValueChanged="PdfDpi_ValueChanged"
                        Value="{x:Bind ViewModel.PdfDpi, Mode=TwoWay}" />

                    <Expander
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        AutomationProperties.AutomationId="OcrSettingsExpander"
                        IsEnabled="{x:Bind ViewModel.CanConfigure, Mode=OneWay}"
                        IsExpanded="False">
                        <Expander.Header>
                            <StackPanel Spacing="4">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="OCR 设置" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind ViewModel.LanguageSummary, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Expander.Header>
                        <StackPanel Spacing="12">
                            <TextBox
                                AutomationProperties.AutomationId="OcrModelDirectory"
                                Header="模型目录"
                                IsReadOnly="True"
                                Text="{x:Bind ViewModel.ModelDirectory, Mode=OneWay}"
                                TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    AutomationProperties.AutomationId="SelectOcrModelDirectory"
                                    Click="SelectModelDirectory_Click"
                                    Content="选择目录" />
                                <Button
                                    AutomationProperties.AutomationId="DefaultOcrModelDirectory"
                                    Click="DefaultModelDirectory_Click"
                                    Content="使用默认目录" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    AutomationProperties.AutomationId="OpenOcrModelDirectory"
                                    Click="OpenModelDirectory_Click"
                                    Content="打开目录" />
                                <Button
                                    AutomationProperties.AutomationId="RefreshOcrLanguages"
                                    Click="RefreshLanguages_Click"
                                    Content="刷新语言" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="识别语言（可多选）" />
                            <ListView
                                MaxHeight="200"
                                AutomationProperties.AutomationId="OcrLanguages"
                                ItemsSource="{x:Bind ViewModel.Languages, Mode=OneWay}"
                                SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:OcrLanguageOption">
                                        <CheckBox
                                            AutomationProperties.AutomationId="OcrLanguageSelection"
                                            AutomationProperties.Name="{x:Bind DisplayName, Mode=OneWay}"
                                            IsChecked="{x:Bind IsSelected, Mode=TwoWay}">
                                            <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}" TextWrapping="Wrap" />
                                        </CheckBox>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <ComboBox
                                HorizontalAlignment="Stretch"
                                AutomationProperties.AutomationId="OcrLayout"
                                Header="重命名识别布局"
                                SelectedIndex="{x:Bind ViewModel.LayoutIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="跟随任务（默认）" />
                                <ComboBoxItem Content="自动" />
                                <ComboBoxItem Content="单行" />
                                <ComboBoxItem Content="单词" />
                            </ComboBox>
                            <ToggleSwitch
                                AutomationProperties.AutomationId="OcrDisableDictionaries"
                                Header="关闭词典纠正（适用于编号）"
                                IsOn="{x:Bind ViewModel.DisableDictionaries, Mode=TwoWay}" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="配置自动保存，下次识别生效。CSV 始终使用整页自动布局。"
                                TextWrapping="Wrap" />
                            <TextBlock Text="从官方仓库下载 .traineddata 文件，放入当前目录后刷新并勾选语言。" TextWrapping="Wrap" />
                            <StackPanel Spacing="4">
                                <HyperlinkButton
                                    AutomationProperties.AutomationId="OcrBestModelsLink"
                                    Content="best（准确率优先）"
                                    NavigateUri="https://github.com/tesseract-ocr/tessdata_best" />
                                <HyperlinkButton
                                    AutomationProperties.AutomationId="OcrFastModelsLink"
                                    Content="fast（速度优先）"
                                    NavigateUri="https://github.com/tesseract-ocr/tessdata_fast" />
                            </StackPanel>
                        </StackPanel>
                    </Expander>
                    <TextBlock
                        AutomationProperties.AutomationId="OcrConfigurationError"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Text="{x:Bind ViewModel.OcrConfigurationError, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        AutomationProperties.AutomationId="OcrSettingsSaveError"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Text="{x:Bind ViewModel.SettingsSaveError, Mode=OneWay}"
                        TextWrapping="Wrap" />

                    <RadioButtons
                        AutomationProperties.AutomationId="OcrRenameMode"
                        Header="重命名模式"
                        IsEnabled="{x:Bind ViewModel.CanConfigure, Mode=OneWay}"
                        SelectedIndex="{x:Bind ViewModel.ModeIndex, Mode=TwoWay}">
                        <x:String>相同尺寸：固定区域</x:String>
                        <x:String>不同尺寸：锚定文本</x:String>
                    </RadioButtons>

                    <TextBox
                        AutomationProperties.AutomationId="OcrAnchorTextInput"
                        Description="例如 Code:，使用该文本之后到行尾的内容。"
                        Header="锚定文本"
                        IsEnabled="{x:Bind ViewModel.CanConfigure, Mode=OneWay}"
                        Text="{x:Bind ViewModel.AnchorText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="OCR 区域（原图百分比）" />
                    <Grid ColumnSpacing="8" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <NumberBox
                            x:Name="RegionXBox"
                            AutomationProperties.AutomationId="OcrRegionX"
                            Header="X"
                            IsEnabled="{x:Bind ViewModel.CanConfigure, Mode=OneWay}"
                            Maximum="100"
                            Minimum="0"
                            ValueChanged="RegionNumberBox_ValueChanged"
                            Value="{x:Bind ViewModel.RegionXPercent, Mode=TwoWay}" />
                        <NumberBox
                            x:Name="RegionYBox"
                            Grid.Column="1"
                            AutomationProperties.AutomationId="OcrRegionY"
                            Header="Y"
                            IsEnabled="{x:Bind ViewModel.CanConfigure, Mode=OneWay}"
                            Maximum="100"
                            Minimum="0"
                            ValueChanged="RegionNumberBox_ValueChanged"
                            Value="{x:Bind ViewModel.RegionYPercent, Mode=TwoWay}" />
                        <NumberBox
                            x:Name="RegionWidthBox"
                            Grid.Row="1"
                            AutomationProperties.AutomationId="OcrRegionWidth"
                            Header="宽度"
                            IsEnabled="{x:Bind ViewModel.CanConfigure, Mode=OneWay}"
                            Maximum="100"
                            Minimum="0"
                            ValueChanged="RegionNumberBox_ValueChanged"
                            Value="{x:Bind ViewModel.RegionWidthPercent, Mode=TwoWay}" />
                        <NumberBox
                            x:Name="RegionHeightBox"
                            Grid.Row="1"
                            Grid.Column="1"
                            AutomationProperties.AutomationId="OcrRegionHeight"
                            Header="高度"
                            IsEnabled="{x:Bind ViewModel.CanConfigure, Mode=OneWay}"
                            Maximum="100"
                            Minimum="0"
                            ValueChanged="RegionNumberBox_ValueChanged"
                            Value="{x:Bind ViewModel.RegionHeightPercent, Mode=TwoWay}" />
                    </Grid>


                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel
                    Margin="0,10"
                    Orientation="Horizontal"
                    Spacing="12">
                    <Button
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="SelectOcrFolderButton"
                        Click="SelectFolder_Click"
                        Content="选择文件夹"
                        IsEnabled="{x:Bind ViewModel.CanConfigure, Mode=OneWay}"
                        Style="{StaticResource AccentButtonStyle}" />
                    <Button
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="GenerateRenamePreviewButton"
                        Click="GeneratePreview_Click"
                        Content="识别并生成重命名预览"
                        IsEnabled="{x:Bind ViewModel.CanStart, Mode=OneWay}"
                        Style="{StaticResource AccentButtonStyle}" />
                    <Button
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="ApplyOcrRenamesButton"
                        Click="ApplyRenames_Click"
                        Content="确认批量重命名"
                        IsEnabled="{x:Bind ViewModel.CanApply, Mode=OneWay}"
                        Style="{StaticResource AccentButtonStyle}" />
                    <Button
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="ExportOcrCsvButton"
                        Click="ExportCsv_Click"
                        Content="导出完整 OCR 为 CSV"
                        IsEnabled="{x:Bind ViewModel.CanExport, Mode=OneWay}" />
                    <Button
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="CancelOcrOperationButton"
                        Click="Cancel_Click"
                        Content="取消当前操作"
                        IsEnabled="{x:Bind ViewModel.CanCancel, Mode=OneWay}" />
                </StackPanel>

                <Grid Grid.Row="1" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <SelectorBar
                        x:Name="ContentSelector"
                        AutomationProperties.AutomationId="RenameByOcrContentSelector"
                        SelectionChanged="ContentSelector_SelectionChanged">
                        <SelectorBarItem Text="文件预览" />
                        <SelectorBarItem Text="重命名结果" />
                    </SelectorBar>

                    <Border
                        x:Name="PreviewPanel"
                        Grid.Row="1"
                        AllowDrop="True"
                        AutomationProperties.AutomationId="OcrFolderDropTarget"
                        AutomationProperties.Name="文件预览，可拖入一个文件夹"
                        Background="Transparent"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        DragOver="PreviewPanel_DragOver"
                        Drop="PreviewPanel_Drop">
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                Margin="12,8"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                IsHitTestVisible="False"
                                Text="将一个文件夹拖到此处，或点击“选择文件夹”；也可通过右上角文件池加入 PDF 或图片。"
                                TextWrapping="Wrap" />
                            <ScrollViewer
                                x:Name="PreviewScrollViewer"
                                Grid.Row="1"
                                AutomationProperties.AutomationId="OcrImagePreview"
                                HorizontalScrollBarVisibility="Auto"
                                HorizontalScrollMode="Enabled"
                                IsTabStop="True"
                                MaxZoomFactor="8"
                                MinZoomFactor="0.1"
                                VerticalScrollBarVisibility="Auto"
                                VerticalScrollMode="Enabled"
                                ZoomMode="Enabled">
                                <Grid Width="{x:Bind ViewModel.PreviewPixelWidth, Mode=OneWay}" Height="{x:Bind ViewModel.PreviewPixelHeight, Mode=OneWay}">
                                    <Image
                                        x:Name="PreviewImage"
                                        AutomationProperties.Name="当前 OCR 文件预览"
                                        Stretch="Fill" />
                                    <Canvas
                                        x:Name="SelectionCanvas"
                                        AutomationProperties.AutomationId="OcrRegionSelectionCanvas"
                                        AutomationProperties.Name="拖动选择 OCR 区域，也可以使用左侧坐标输入框"
                                        Background="Transparent"
                                        IsHitTestVisible="{x:Bind ViewModel.CanConfigure, Mode=OneWay}"
                                        PointerCanceled="SelectionCanvas_PointerCanceled"
                                        PointerMoved="SelectionCanvas_PointerMoved"
                                        PointerPressed="SelectionCanvas_PointerPressed"
                                        PointerReleased="SelectionCanvas_PointerReleased">
                                        <Rectangle
                                            x:Name="SelectionRectangle"
                                            Canvas.ZIndex="1"
                                            Fill="{ThemeResource AccentFillColorSecondaryBrush}"
                                            IsHitTestVisible="False"
                                            Stroke="{ThemeResource SystemFillColorCriticalBrush}"
                                            StrokeThickness="3"
                                            Visibility="Collapsed" />
                                    </Canvas>
                                </Grid>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <Grid
                        x:Name="ResultsPanel"
                        Grid.Row="1"
                        Visibility="Collapsed">
                        <ListView
                            Grid.Row="0"
                            AutomationProperties.AutomationId="OcrRenameResults"
                            IsEnabled="{x:Bind ViewModel.CanConfigure, Mode=OneWay}"
                            ItemsSource="{x:Bind ViewModel.Results, Mode=OneWay}">
                            <ListView.Header>
                                <Grid
                                    Padding="12,8"
                                    Background="Transparent"
                                    ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="240" />
                                        <ColumnDefinition Width="5*" />
                                        <ColumnDefinition Width="5*" />
                                        <ColumnDefinition Width="240" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="原文件名" />
                                    <TextBlock
                                        Grid.Column="1"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="OCR 文本" />
                                    <TextBlock
                                        Grid.Column="2"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="错误" />
                                    <TextBlock
                                        Grid.Column="3"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="目标文件名" />
                                    <TextBlock
                                        Grid.Column="4"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="状态" />
                                </Grid>
                            </ListView.Header>

                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:RenamePreviewItem">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="240" />
                                            <ColumnDefinition Width="5*" />
                                            <ColumnDefinition Width="5*" />
                                            <ColumnDefinition Width="240" />
                                            <ColumnDefinition Width="120" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{x:Bind OriginalName, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Text="{x:Bind OcrText, Mode=OneWay}"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            Grid.Column="2"
                                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                            Text="{x:Bind Error, Mode=OneWay}"
                                            TextWrapping="Wrap" />
                                        <TextBox
                                            Grid.Column="3"
                                            AutomationProperties.AutomationId="OcrTargetNameInput"
                                            AutomationProperties.Name="目标文件名（含扩展名）"
                                            IsEnabled="{x:Bind CanEditTarget, Mode=OneWay}"
                                            Text="{x:Bind TargetName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock
                                            Grid.Column="4"
                                            Text="{x:Bind Status, Mode=OneWay}"
                                            TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>
            </Grid>

        </Grid>

        <ProgressBar
            Grid.Row="1"
            AutomationProperties.AutomationId="OcrBatchProgress"
            IsIndeterminate="{x:Bind ViewModel.IsProgressIndeterminate, Mode=OneWay}"
            Maximum="{x:Bind ViewModel.ProgressMaximum, Mode=OneWay}"
            Value="{x:Bind ViewModel.ProgressValue, Mode=OneWay}" />

        <StackPanel Grid.Row="2" Spacing="8">
            <InfoBar
                Title="当前平台不支持 OCR"
                AutomationProperties.AutomationId="RenameByOcrUnsupportedInfo"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.IsUnsupported, Mode=OneWay}"
                Message="当前为 ARM64 进程。Tesseract 原生组件仅支持 x86/x64，因此此页面的 OCR 操作已禁用。"
                Severity="Warning" />
            <InfoBar
                AutomationProperties.AutomationId="RenameByOcrStatus"
                IsClosable="False"
                IsOpen="True"
                Message="{x:Bind ViewModel.ProgressText, Mode=OneWay}"
                Severity="Informational" />
        </StackPanel>
    </Grid>
</Page>
