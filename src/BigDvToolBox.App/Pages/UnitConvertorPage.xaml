<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BigDvToolBox_App.Pages.UnitConvertorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:BigDvToolBox_App.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <TabView
        Margin="12"
        AutomationProperties.AutomationId="UnitConverterCategories"
        IsAddTabButtonVisible="False"
        VerticalAlignment="Stretch">
        <TabViewItem
            AutomationProperties.AutomationId="LengthConverterTab"
            Header="长度转换"
            IsClosable="False">
            <ScrollViewer HorizontalAlignment="Stretch" HorizontalScrollBarVisibility="Disabled">
                <StackPanel
                    Padding="24"
                    Spacing="16">
                    <TextBlock
                        Style="{StaticResource TitleTextBlockStyle}"
                        Text="长度转换" />
                    <TextBlock
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="三组数值都可作为输入源。按 Enter，或离开当前输入框时转换。"
                        TextWrapping="Wrap" />

                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="280" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="12">
                            <TextBlock
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                Text="公制" />
                            <NumberBox
                                x:Name="MetricValueNumberBox"
                                AutomationProperties.AutomationId="MetricLengthInput"
                                Header="数值"
                                LostFocus="MetricInput_LostFocus"
                                Minimum="0"
                                SpinButtonPlacementMode="Compact"
                                ValidationMode="InvalidInputOverwritten"
                                Value="{x:Bind ViewModel.MetricValue, Mode=TwoWay}" />
                            <ComboBox
                                x:Name="MetricUnitComboBox"
                                AutomationProperties.AutomationId="MetricLengthUnit"
                                Header="单位"
                                LostFocus="MetricInput_LostFocus"
                                SelectedIndex="{x:Bind ViewModel.MetricUnitIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="毫米 (mm)" />
                                <ComboBoxItem Content="厘米 (cm)" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="12">
                            <TextBlock
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                Text="小数英寸" />
                            <NumberBox
                                x:Name="DecimalInchNumberBox"
                                AutomationProperties.AutomationId="DecimalInchInput"
                                Header="英寸 (in)"
                                LostFocus="DecimalInchInput_LostFocus"
                                Minimum="0"
                                SpinButtonPlacementMode="Compact"
                                ValidationMode="InvalidInputOverwritten"
                                Value="{x:Bind ViewModel.DecimalInchValue, Mode=TwoWay}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Spacing="12">
                            <TextBlock
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                Text="分数英寸" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="104" />
                                </Grid.ColumnDefinitions>
                                <NumberBox
                                    x:Name="FractionWholeNumberBox"
                                    AutomationProperties.AutomationId="FractionWholeInchInput"
                                    Header="整数"
                                    LostFocus="FractionInput_LostFocus"
                                    Minimum="0"
                                    SmallChange="1"
                                    ValidationMode="InvalidInputOverwritten"
                                    Value="{x:Bind ViewModel.FractionWholeInches, Mode=TwoWay}" />
                                <NumberBox
                                    x:Name="FractionNumeratorNumberBox"
                                    Grid.Column="1"
                                    AutomationProperties.AutomationId="FractionNumeratorInput"
                                    Header="分子"
                                    LostFocus="FractionInput_LostFocus"
                                    Minimum="0"
                                    SmallChange="1"
                                    ValidationMode="InvalidInputOverwritten"
                                    Value="{x:Bind ViewModel.FractionNumerator, Mode=TwoWay}" />
                                <ComboBox
                                    x:Name="FractionDenominatorComboBox"
                                    Grid.Column="2"
                                    AutomationProperties.AutomationId="FractionDenominatorInput"
                                    Header="分母"
                                    LostFocus="FractionInput_LostFocus"
                                    SelectedIndex="{x:Bind ViewModel.FractionDenominatorIndex, Mode=TwoWay}">
                                    <ComboBoxItem Content="2" />
                                    <ComboBoxItem Content="4" />
                                    <ComboBoxItem Content="8" />
                                    <ComboBoxItem Content="16" />
                                    <ComboBoxItem Content="32" />
                                    <ComboBoxItem Content="64" />
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <TextBlock
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.LengthStatus, Mode=OneWay}" />
                </StackPanel>
            </ScrollViewer>
        </TabViewItem>

        <TabViewItem
            AutomationProperties.AutomationId="FlowConverterTab"
            Header="流量转换"
            IsClosable="False">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <Grid
                    x:Name="FlowContentGrid"
                    Padding="24"
                    ColumnSpacing="24"
                    RowSpacing="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*" />
                        <ColumnDefinition Width="5*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel
                        x:Name="FlowConverterPanel"
                        MaxWidth="540"
                        HorizontalAlignment="Left"
                        Spacing="16">
                        <TextBlock
                            Style="{StaticResource TitleTextBlockStyle}"
                            Text="流量转换" />
                        <TextBlock
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="升/分钟与美制加仑/分钟双向换算。1 US gal = 3.785411784 L。"
                            TextWrapping="Wrap" />

                        <Grid
                            x:Name="FlowInputsGrid"
                            ColumnSpacing="16"
                            RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition  Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <NumberBox
                                AutomationProperties.AutomationId="FlowInput"
                                Header="输入数值"
                                Minimum="0"
                                SpinButtonPlacementMode="Compact"
                                ValidationMode="InvalidInputOverwritten"
                                Value="{x:Bind ViewModel.FlowInputValue, Mode=TwoWay}" />

                            <ComboBox
                                x:Name="FlowSourceUnitControl"
                                Grid.Row="1"
                                AutomationProperties.AutomationId="FlowSourceUnit"
                                Header="输入单位"
                                SelectedIndex="{x:Bind ViewModel.FlowSourceUnitIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="升/分钟 (L/min)" />
                                <ComboBoxItem Content="美制加仑/分钟 (US GPM)" />
                            </ComboBox>
                        </Grid>

                        <TextBox
                            x:Name="FlowResultTextBox"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.AutomationId="FlowResult"
                            Header="转换结果"
                            IsReadOnly="True"
                            Text="{x:Bind ViewModel.FlowResult, Mode=OneWay}" />

                        <TextBlock
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.FlowTargetUnit, Mode=OneWay}" />
                        
                    </StackPanel>

                    <Border
                        x:Name="FlowStandardsPanel"
                        Grid.Row="0" Grid.RowSpan="2"
                        Grid.Column="1"
                        Padding="20"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="FlowStandardsReference"
                        AutomationProperties.Name="美国流量标准速查"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel Spacing="14">
                            <TextBlock
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                Text="美国流量标准速查" />
                            <TextBlock
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="CEC-140-2021-002（California Title 20）、CALGreen 与 ASME A112.18.1/CSA B125.1"
                                TextWrapping="Wrap" />

                            <StackPanel Spacing="4">
                                <TextBlock
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="私用面盆龙头" />
                                <TextBlock
                                    Text="CEC Title 20：最大 1.2 GPM / 4.5 L/min @ 60 psi / 4.1 bar"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <Border
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="0,1,0,0" />

                            <StackPanel Spacing="4">
                                <TextBlock
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="厨房龙头" />
                                <TextBlock
                                    Text="CEC Title 20：默认流量最大 1.8 GPM / 6.8 L/min @ 60 psi / 4.1 bar"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="多出水模式：带自动回位时，第一出水应符合 1.8 GPM 限值；不带自动回位时，第一和第二出水均不得超过 1.8 GPM。"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <Border
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="0,1,0,0" />

                            <StackPanel Spacing="4">
                                <TextBlock
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="浴缸出水口" />
                                <TextBlock
                                    Text="CEC / ASME：最小 2.4 GPM / 9.0 L/min @ 20 psi / 1.4 bar"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <Border
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="0,1,0,0" />

                            <StackPanel Spacing="4">
                                <TextBlock
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="花洒（手持、顶喷、背喷）" />
                                <TextBlock
                                    Text="CEC Title 20：最大 2.0 GPM / 7.6 L/min @ 80 psi / 5.5 bar"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Text="CALGreen：最大 1.8 GPM / 6.8 L/min @ 80 psi / 5.5 bar"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Text="ASME A112.18.1/CSA B125.1：最大 2.5 GPM / 9.5 L/min @ 80 psi / 5.5 bar"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <TextBlock
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="工程速查，正式判定以标准原文和适用版本为准。"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    
                </Grid>
            </ScrollViewer>
        </TabViewItem>
    </TabView>
</Page>
