<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="BigDvToolBox_App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:filePool="using:BigDvToolBox_App.Features.FilePool"
    xmlns:local="using:BigDvToolBox_App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="BigDvToolBox"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base" />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Title="BigDvToolBox"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="TitleBar_PaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="/Assets/BigDvToolBoxIcon.ico" />
            </TitleBar.IconSource>
            <TitleBar.RightHeader>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="FilePoolButton" Content="文件池 · 0" Click="FilePoolButton_Click"
                        VerticalAlignment="Center" AutomationProperties.AutomationId="OpenFilePool"
                        AutomationProperties.Name="打开公共文件池" ToolTipService.ToolTip="打开公共文件池" />
                <MenuBar
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="TitleBarMenu"
                    AutomationProperties.Name="应用菜单">
                    <MenuBarItem
                        Title="帮助"
                        AutomationProperties.AutomationId="TitleBarHelp"
                        AutomationProperties.Name="帮助">
                        <MenuFlyoutItem
                            AutomationProperties.AutomationId="TitleBarReleases"
                            AutomationProperties.Name="GitHub Releases"
                            Click="ReleasesMenuItem_Click"
                            Text="GitHub Releases" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem
                            AutomationProperties.AutomationId="ShowAboutDialog"
                            AutomationProperties.Name="关于 BigDvToolBox"
                            Click="AboutMenuItem_Click"
                            Text="关于" />
                    </MenuBarItem>
                </MenuBar>
                </StackPanel>
            </TitleBar.RightHeader>
        </TitleBar>

        <SplitView x:Name="FilePoolDrawer" Grid.Row="1" DisplayMode="Overlay" PanePlacement="Right"
            OpenPaneLength="360" IsPaneOpen="False" LightDismissOverlayMode="On"
            PaneOpened="FilePoolDrawer_PaneOpened" PaneClosed="FilePoolDrawer_PaneClosed" SizeChanged="FilePoolDrawer_SizeChanged">
            <SplitView.Pane>
                <Border BorderThickness="1,0,0,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <filePool:FilePoolPanel x:Name="PoolPanel" />
                </Border>
            </SplitView.Pane>
        <NavigationView
            x:Name="NavView"
            AutomationProperties.AutomationId="MainNavigation"
            AutomationProperties.Name="工具导航"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            SelectionChanged="NavView_SelectionChanged">
            <TabView
                x:Name="ToolTabView"
                VerticalAlignment="Stretch"
                AutomationProperties.AutomationId="ToolTabs"
                AutomationProperties.Name="打开的工具"
                CloseButtonOverlayMode="OnPointerOver"
                IsAddTabButtonVisible="False"
                SelectionChanged="ToolTabView_SelectionChanged"
                TabCloseRequested="ToolTabView_TabCloseRequested" />
        </NavigationView>
        </SplitView>

        <ContentDialog
            x:Name="AboutDialog"
            Title="关于 BigDvToolBox"
            Grid.RowSpan="2"
            AutomationProperties.AutomationId="AboutDialog"
            CloseButtonText="关闭"
            DefaultButton="Close">
            <StackPanel Width="360" Spacing="12">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="BigDvToolBox" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="版本" />
                    <TextBlock IsTextSelectionEnabled="True" Text="{x:Bind About.AppVersion, Mode=OneTime}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="开发者" />
                    <TextBlock Text="{x:Bind About.Developer, Mode=OneTime}" />
                </StackPanel>
                <TextBlock
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind About.Copyright, Mode=OneTime}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="开源许可：GNU AGPL v3 或更高版本。软件按现状提供，不附带任何担保。"
                    TextWrapping="Wrap" />
                <TextBlock Text="Ghostscript 10.07.1（AGPL-3.0-or-later）。第三方组件的版权和许可见程序目录中的 THIRD-PARTY-NOTICES.md 与 Licenses 文件夹。"
                           TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <HyperlinkButton Content="源代码与项目主页" NavigateUri="{x:Bind About.RepositoryUri, Mode=OneTime}"
                                 AutomationProperties.AutomationId="AboutRepository" />
                <HyperlinkButton Content="下载绿色版（GitHub Releases）" NavigateUri="{x:Bind About.ReleasesUri, Mode=OneTime}"
                                 AutomationProperties.AutomationId="AboutReleases" />
                <HyperlinkButton Content="问题反馈" NavigateUri="{x:Bind About.IssuesUri, Mode=OneTime}"
                                 AutomationProperties.AutomationId="AboutIssues" />
                <HyperlinkButton Content="开源许可证" NavigateUri="{x:Bind About.LicenseUri, Mode=OneTime}"
                                 AutomationProperties.AutomationId="AboutLicense" />
            </StackPanel>
        </ContentDialog>
    </Grid>
</Window>
